n><span className="flex min-w-0 flex-1 items-center justify-center rounded-full bg-gray-200 px-2 py-1 text-[10px] font-extrabold text-[#17171b]">{personal}</span><span className="flex shrink-0 items-center gap-1 text-[10px] font-bold text-white"><MessageCircle className="h-3 w-3" />{reviewCount}</span></div></div><div className="p-3.5"><span className="mb-1.5 inline-block rounded-full border border-[#2a2a32] px-2 py-0.5 text-[10px] font-medium text-gray-400">{release.type} · {release.year}</span><h3 className="truncate text-sm font-bold text-white">{release.title}</h3><p className="truncate text-xs text-gray-400">{release.artist}</p></div></button>; })}</div></section>;
